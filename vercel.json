{
  "redirects": [
    { "source": "/google-apps-script/:path*", "destination": "/", "permanent": false },
    { "source": "/_source/:path*", "destination": "/", "permanent": false },
    { "source": "/README.md", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/admin.html", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/js/config.js", "headers": [ { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] },
    { "source": "/(.*)\\.(jpg|jpeg|png|svg|mp4|webp)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] }
  ]
}
